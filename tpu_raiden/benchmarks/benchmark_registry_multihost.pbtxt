benchmarks {
  name: "h2h_multihost_correctness"
  description: "Cross-host H2H over a real NIC: byte-integrity gate. Same configs as the single-host loopback gate, so a green single-host run and a red multi-host run isolate the difference to the real socket path."
  owner: "raiden-dev"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//tpu_raiden/benchmarks:h2h_multihost_gate" }
    action_inputs { key: "runtime_flags" value: "--suite=correctness --iters=5 --data_interface=eth0 --dump=h2h_multihost_samples.csv" }
  }

  environment_configs {
    id: "tpu-v5e-16-multihost"
    runner_label: "linux-x86-ct5lp-4tpu-x4"
    container_image: "us-central1-docker.pkg.dev/wyzhang-dev/quickstart-docker-repo/ml-build:939285342"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=oss --config=ci" }
  }

  metrics { name: "1048576B_x64_P1/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "1048576B_x64_P8/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "1048573B_x64_P4/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
}

benchmarks {
  name: "h2h_multihost_perf"
  description: "Cross-host H2H parallelism sweep at 2 MiB blocks. Throughput gating stays OFF until a baseline is recorded and its spread is understood; integrity always gates."
  owner: "raiden-dev"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//tpu_raiden/benchmarks:h2h_multihost_gate" }
    action_inputs { key: "runtime_flags" value: "--suite=perf --iters=200 --data_interface=eth0 --dump=h2h_multihost_perf_samples.csv" }
  }

  environment_configs {
    id: "tpu-v5e-16-multihost"
    runner_label: "linux-x86-ct5lp-4tpu-x4"
    container_image: "us-central1-docker.pkg.dev/wyzhang-dev/quickstart-docker-repo/ml-build:939285342"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=oss --config=ci" }
  }

  metrics { name: "2097152B_x64_P1/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "2097152B_x64_P2/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "2097152B_x64_P4/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "2097152B_x64_P8/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "2097152B_x64_P16/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
}
